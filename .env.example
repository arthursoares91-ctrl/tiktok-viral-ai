# ══════════════════════════════════════════════════════════════════
# TIKTOK VIRAL AI — Variáveis de Ambiente
# ══════════════════════════════════════════════════════════════════
# Copie este arquivo para .env.local e preencha com seus valores.
# NUNCA commite o .env.local no repositório.
# ══════════════════════════════════════════════════════════════════

# ── SUPABASE ──────────────────────────────────────────────────────
# Encontre em: Supabase Dashboard → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── ANTHROPIC (Claude AI) ─────────────────────────────────────────
# Encontre em: console.anthropic.com → API Keys
# ATENÇÃO: Em produção, use a Edge Function como proxy (ver README)
# e mantenha esta chave APENAS no servidor (Supabase Secrets).
ANTHROPIC_API_KEY=sk-ant-api03-...

# ── STRIPE (Pagamentos internacionais) ───────────────────────────
# Encontre em: dashboard.stripe.com → Developers → API Keys
# Use sk_test_ para testes e sk_live_ para produção
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Price IDs dos planos (criar em Stripe Dashboard → Products)
STRIPE_PRICE_PRO=price_...
STRIPE_PRICE_PREMIUM=price_...

# ── MERCADO PAGO (Pagamentos BR — PIX, boleto, cartão) ────────────
# Encontre em: mercadopago.com.br/developers → Suas integrações
MP_ACCESS_TOKEN=APP_USR-...
MP_PUBLIC_KEY=APP_USR-...

# ── APP ───────────────────────────────────────────────────────────
# URL pública do seu app (sem barra final)
NEXT_PUBLIC_APP_URL=https://tiktok-viral-ai.vercel.app
